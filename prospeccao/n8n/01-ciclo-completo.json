{
  "name": "Prospecção — ciclo completo (a cada 2 h, dias úteis)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8-17/2 * * 1-5"
            }
          ]
        }
      },
      "name": "A cada 2 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/run/ciclo",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PROSPECTOR_API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 1800000
        }
      },
      "name": "Rodar ciclo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    }
  ],
  "connections": {
    "A cada 2 horas": {
      "main": [
        [
          {
            "node": "Rodar ciclo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "America/Sao_Paulo",
    "executionOrder": "v1"
  },
  "active": false
}
