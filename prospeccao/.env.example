# Copie para .env e preencha. Este arquivo NÃO vai para o git.

# Senhas internas — gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
PROSPECTOR_API_TOKEN=
EVOLUTION_APIKEY=
REACHER_SECRET=

# Endereço público da API (link de descadastro dos e-mails). Precisa ser HTTPS.
PROSPECTOR_PUBLIC_URL=https://prospeccao.seudominio.com.br

# Simulação: true só registra as mensagens no banco e no log. Mude para false para enviar.
PROSPECTOR_DRY_RUN=true

# WhatsApp
EVOLUTION_INSTANCE=prospeccao

# E-mail de saída — use um SUBDOMÍNIO dedicado (ex.: contato.seudominio.com.br)
# com SPF, DKIM e DMARC configurados. Reputação de prospecção não pode
# contaminar o e-mail da empresa.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Mesma caixa, para ler respostas e bounces
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Reacher: o HELO e o remetente da verificação devem bater com o DNS reverso do servidor.
REACHER_HELLO_NAME=
REACHER_FROM_EMAIL=

# Opcional: pesquisa da empresa e frase de abertura personalizada com o Claude.
# Sem a chave, o sistema usa só os templates.
ANTHROPIC_API_KEY=
PROSPECTOR_MODEL=claude-opus-5-5

# A Receita já trocou este token antes. Se o download falhar, pegue o novo em
# https://arquivos.receitafederal.gov.br (Dados > Cadastros > CNPJ, o código após /s/ na URL).
RECEITA_SHARE_TOKEN=gn672Ad4CF8N6TK
