# Copie para .env e preencha. Este arquivo NÃO vai para o git.
# Passo a passo no Windows: WINDOWS.md

# Senhas internas — invente uma por linha. Gerar no PowerShell:
#   [guid]::NewGuid().ToString('N')
# No Linux/Mac: openssl rand -hex 24
POSTGRES_PASSWORD=
PROSPECTOR_API_TOKEN=
EVOLUTION_APIKEY=

# Simulação: true só registra as mensagens no banco e no log. Mude para false para enviar.
PROSPECTOR_DRY_RUN=true

# Endereço público da API, usado no link de descadastro dos e-mails.
# Grátis: Tailscale Funnel (ver WINDOWS.md), ex.: https://meu-pc.tail1234.ts.net
# Se você só vai usar WhatsApp, pode deixar como está.
PROSPECTOR_PUBLIC_URL=http://localhost:8000

# WhatsApp
EVOLUTION_INSTANCE=prospeccao

# E-mail de saída. Grátis: uma conta Gmail NOVA, só para prospecção, com
# "senha de app" (myaccount.google.com/apppasswords — exige verificação em
# duas etapas). Não use seu Gmail pessoal.
# Com domínio próprio: use um subdomínio dedicado com SPF, DKIM e DMARC.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Mesma caixa, para ler respostas e bounces
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Opcional: pesquisa da empresa e frase de abertura personalizada com o Claude (pago).
# Sem a chave, o sistema usa só os templates.
ANTHROPIC_API_KEY=
PROSPECTOR_MODEL=claude-opus-5-5

# Opcional, só para servidor com porta 25 de saída liberada (internet de casa
# no Brasil bloqueia). Sem ele, o e-mail é checado pelo DNS do domínio.
#   docker compose --profile reacher up -d
# REACHER_URL=http://reacher:8080
# REACHER_SECRET=
# REACHER_HELLO_NAME=
# REACHER_FROM_EMAIL=

# A Receita já trocou este token antes. Se o download falhar, pegue o novo em
# https://arquivos.receitafederal.gov.br (Dados > Cadastros > CNPJ, o código após /s/ na URL).
RECEITA_SHARE_TOKEN=gn672Ad4CF8N6TK
